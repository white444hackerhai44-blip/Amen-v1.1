-- Get players
local function getPlayers(input)
    local players = {}
    input = string.lower(input or "")
    
    if input == "all" then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer then table.insert(players, p) end
        end
    elseif input == "nonfriends" then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local success, isFriend = pcall(function()
                    return p:IsFriendsWith(localPlayer.UserId)
                end)
                if not (success and isFriend) then
                    table.insert(players, p)
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local name = string.lower(p.Name)
                local display = string.lower(p.DisplayName or "")
                if string.find(name, input) or string.find(display, input) then
                    table.insert(players, p)
                end
            end
        end
    end
    return players
end

-- Ultra Fling
local function ultraFling(target)
    local char = localPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local targetChar = target.Character
    if not targetChar then return end
    
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    if root.Velocity.Magnitude < 50 then
        getgenv().OldPos = root.CFrame
    end
    
    workspace.FallenPartsDestroyHeight = 0/0
    
    local power = 9e99
    
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(power, power * 10, power)
    bv.MaxForce = Vector3.new(power, power, power)
    bv.Parent = root
    
    local bg = Instance.new("BodyGyro")
    bg.CFrame = CFrame.new(root.Position)
    bg.D = power
    bg.MaxTorque = Vector3.new(power, power, power)
    bg.P = power
    bg.Parent = root
    
    local bp = Instance.new("BodyPosition")
    bp.Position = targetRoot.Position + Vector3.new(0, 50, 0)
    bp.D = power
    bp.MaxForce = Vector3.new(power, power, power)
    bp.P = power
    bp.Parent = root
    
    local start = tick()
    while flingActive and targetChar.Parent and tick() - start < 1.5 do
        targetRoot.AssemblyLinearVelocity = Vector3.new(power, power, power)
        targetRoot.AssemblyAngularVelocity = Vector3.new(power, power, power)
        root.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(0, 3, 0)
        root.AssemblyLinearVelocity = Vector3.new(power, power, power)
        task.wait()
    end
    
    pcall(function() bv:Destroy() end)
    pcall(function() bg:Destroy() end)
    pcall(function() bp:Destroy() end)
    
    if getgenv().OldPos then
        root.CFrame = getgenv().OldPos
    end
end

