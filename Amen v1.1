-- ===== ENTER KEY =====
inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        currentInput = string.lower(inputBox.Text)
        if flingActive then
            flingActive = false
            mainBtn.Text = "FLING: OFF"
            mainBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
            wait(0.1)
            flingActive = true
            mainBtn.Text = "FLING: ON 🔥"
            mainBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
            spawn(function()
                local players = getPlayers(currentInput)
                if #players == 0 then
                    statusLabel.Text = "❌ No players!"
                    flingActive = false
                    mainBtn.Text = "FLING: OFF"
                    mainBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
                    return
                end
                statusLabel.Text = "⚡ Flinging " .. #players .. " players"
                while flingActive do
                    for _, player in pairs(players) do
                        if not flingActive then break end
                        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            ultraFling(player)
                        end
                        task.wait(0.1)
                    end
                end
            end)
        end
    end
end)

