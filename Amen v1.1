-- ===== PHASE TOGGLE =====
local isPhase2 = false
local isPhase3 = false

local function togglePhase()
    if not isPhase2 and not isPhase3 then
        isPhase2 = true
        togglePhaseBtn.Text = "2"
        for _, btn in pairs({inputBox, modeContainer, buttons.touchFling, buttons.antiFling, buttons.antiKill, buttons.noclip, buttons.revenge, buttons.lagSwitch, statusLabel, speedLabel, boostLabel}) do
            if btn then btn.Visible = false end
        end
        for k, btn in pairs(phaseButtons) do
            if btn then
                btn.Visible = (k == "strength" or k == "spawnpoint" or k == "antiSlap" or k == "xenoAntiFling" or k == "infinitePos" or k == "antiFall")
            end
        end
        updateCanvas()
    elseif isPhase2 then
        isPhase2 = false
        isPhase3 = true
        togglePhaseBtn.Text = "3"
        for k, btn in pairs(phaseButtons) do
            if btn then
                if k == "strength" or k == "spawnpoint" or k == "antiSlap" or k == "xenoAntiFling" or k == "infinitePos" or k == "antiFall" then
                    btn.Visible = false
                elseif k == "antiSit" or k == "antiConveyor" or k == "freeCam" or k == "invis" or k == "antiRagdoll" or k == "punchFling" then
                    btn.Visible = true
                end
            end
        end
        updateCanvas()
    else
        isPhase3 = false
        togglePhaseBtn.Text = "1"
        for _, btn in pairs({inputBox, modeContainer, buttons.touchFling, buttons.antiFling, buttons.antiKill, buttons.noclip, buttons.revenge, buttons.lagSwitch, statusLabel, speedLabel, boostLabel}) do
            if btn then btn.Visible = true end
        end
        for k, btn in pairs(phaseButtons) do
            if btn then
                if k == "antiSit" or k == "antiConveyor" or k == "freeCam" or k == "invis" or k == "antiRagdoll" or k == "punchFling" then
                    btn.Visible = false
                end
            end
        end
        updateCanvas()
    end
end

