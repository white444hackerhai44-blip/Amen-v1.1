-- ===== TOUCH FLING AUTO-BOOST SYSTEM =====
local touchFlingActive = false
local touchFlingSpeed = 0
local touchFlingBoost = 1
local touchFlingMaxBoost = 999999
local touchFlingConnection = nil
local touchFlingLoop = nil

-- Auto-Boost Touch Fling - UNLIMITED SPEED
local function startTouchFling()
    touchFlingActive = true
    touchFlingSpeed = 1000
    touchFlingBoost = 1
    
    buttons.touchFling.Text = "🚀 TOUCH FLING: ON 🔥"
    buttons.touchFling.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
    statusLabel.Text = "⚡ TOUCH FLING ACTIVE - BOOSTING..."
    speedLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    -- Main boost loop - NEVER STOPS
    touchFlingLoop = RunService.Heartbeat:Connect(function()
        if not touchFlingActive then return end
        
        local char = localPlayer.Character
        if not char then return end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        -- AUTO-BOOST: Increase speed every frame
        touchFlingBoost = touchFlingBoost * 1.05  -- 5% increase per frame
        if touchFlingBoost > touchFlingMaxBoost then
            touchFlingBoost = touchFlingMaxBoost
        end
        
        -- Calculate current speed (exponential growth)
        local currentSpeed = touchFlingSpeed * touchFlingBoost
        if currentSpeed > 9e99 then currentSpeed = 9e99 end
        
        -- Apply velocity with increasing power
        hrp.AssemblyLinearVelocity = Vector3.new(currentSpeed, currentSpeed * 100, currentSpeed)
        hrp.AssemblyAngularVelocity = Vector3.new(currentSpeed * 10, currentSpeed * 10, currentSpeed * 10)
        
        -- Also apply to all parts in character for maximum effect
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part ~= hrp then
                part.AssemblyLinearVelocity = Vector3.new(currentSpeed, currentSpeed * 100, currentSpeed)
                part.AssemblyAngularVelocity = Vector3.new(currentSpeed * 10, currentSpeed * 10, currentSpeed * 10)
            end
        end
        
        -- Update boost display
        local boostDisplay = math.floor(touchFlingBoost)
        if boostDisplay > 999999 then boostDisplay = 999999 end
        boostLabel.Text = "BOOST: x" .. boostDisplay .. " 🔥"
        
        -- Color based on boost level
        if boostDisplay > 100000 then
            boostLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            speedLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            statusLabel.Text = "💀 ULTRA BOOST x" .. boostDisplay
        elseif boostDisplay > 10000 then
            boostLabel.TextColor3 = Color3.fromRGB(255, 100, 0)
            speedLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
            statusLabel.Text = "🔥 MEGA BOOST x" .. boostDisplay
        elseif boostDisplay > 1000 then
            boostLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            speedLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            statusLabel.Text = "⚡ SUPER BOOST x" .. boostDisplay
        else
            boostLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
        
        -- Update speed display
        local speedDisplay = math.floor(currentSpeed)
        if speedDisplay > 999999999 then
            speedLabel.Text = "SPEED: ∞ 🚀"
        else
            speedLabel.Text = "SPEED: " .. speedDisplay .. " 🚀"
        end
        
        -- Jump higher automatically
        if hrp.Velocity.Y < 1000 then
            hrp.AssemblyLinearVelocity = Vector3.new(currentSpeed, currentSpeed * 1000, currentSpeed)
        end
        
        -- Force teleport up to avoid ground
        if hrp.Position.Y < 10 then
            hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 100, hrp.Position.Z)
        end
    end)
    
    -- Extra boost loop for even more power
    touchFlingConnection = RunService.RenderStepped:Connect(function()
        if not touchFlingActive then return end
        
        local char = localPlayer.Character
        if not char then return end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        -- Additional boost every render frame
        touchFlingBoost = touchFlingBoost * 1.01
        if touchFlingBoost > touchFlingMaxBoost then
            touchFlingBoost = touchFlingMaxBoost
        end
        
        -- Extra velocity push
        local extraSpeed = (touchFlingSpeed * touchFlingBoost) / 10
        hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + Vector3.new(extraSpeed, extraSpeed * 100, extraSpeed)
        
        -- Create explosion effect for visual feedback
        if math.random(1, 100) == 1 then
            local exp = Instance.new("Explosion")
            exp.BlastRadius = 10
            exp.BlastPressure = 1000
            exp.Position = hrp.Position
            exp.Parent = workspace
            Debris:AddItem(exp, 0.1)
        end
    end)
end

local function stopTouchFling()
    touchFlingActive = false
    
    if touchFlingLoop then
        touchFlingLoop:Disconnect()
        touchFlingLoop = nil
    end
    
    if touchFlingConnection then
        touchFlingConnection:Disconnect()
        touchFlingConnection = nil
    end
    
    buttons.touchFling.Text = "🚀 TOUCH FLING: OFF"
    buttons.touchFling.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    statusLabel.Text = "✅ Touch Fling Stopped"
    boostLabel.Text = "BOOST: x0 🔥"
    boostLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    speedLabel.TextColor3 = Color3.new(1, 1, 1)
    touchFlingBoost = 1
    
    -- Reset velocity
    local char = localPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new()
            hrp.AssemblyAngularVelocity = Vector3.new()
        end
    end
end

